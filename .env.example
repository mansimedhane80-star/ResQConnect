# Copy to .env and replace both values with private local credentials.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/resq_connect
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional override; default is backend/.private_documents, outside static files.
# ADMIN_DOCUMENTS_DIR=C:/resqconnect-private-documents

# Optional email notifications (SMTP). Leave unset to disable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional SMS notifications through Twilio. Requires an account that can send to India.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public frontend origin used to create private token-based tracking links.
PUBLIC_WEB_URL=http://localhost:5173

# Optional private/self-hosted Nominatim-compatible reverse-geocoding endpoint.
# Exact SOS coordinates are sent to this endpoint; do not use the public OSM service.
# REVERSE_GEOCODER_URL=https://geocoder.internal.example/reverse
GEOCODER_USER_AGENT=ResQConnect/1.0
